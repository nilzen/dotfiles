{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/olov.nilzen/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Bottle.aiff >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Basso.aiff >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Funk.aiff >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash '/Users/olov.nilzen/.claude/statusline-command.sh'"
  },
  "extraKnownMarketplaces": {
    "hiroppy": {
      "source": {
        "source": "directory",
        "path": "/Users/olov.nilzen/.tmux/plugins/tmux-agent-sidebar"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "low"
    },
    "claude-opus-5": {
      "effortLevel": "low"
    },
    "claude-fable-5-1": {
      "effortLevel": "low"
    }
  },
  "autoCompactWindow": 300000,
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "theme": "dark",
  "voiceEnabled": false,
  "enabledPlugins": {
    "tmux-agent-sidebar@hiroppy": true
  }
}
