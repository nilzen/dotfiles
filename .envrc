# Use the personal GitHub account for gh in this repo (global default is the work account).
# Fails soft if the account isn't logged in: run `gh auth login` and choose nilzen.
if token=$(gh auth token --user nilzen 2>/dev/null) && [ -n "$token" ]; then
  export GH_TOKEN="$token"
else
  log_status "gh: account 'nilzen' not logged in, using the active gh account"
fi
