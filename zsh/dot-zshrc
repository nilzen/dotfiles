# ~/.zshrc

# ================ History ===================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY        # Share history across all sessions in real time
setopt HIST_IGNORE_DUPS     # Don't record consecutive duplicate commands
setopt HIST_IGNORE_SPACE    # Don't record commands starting with a space
setopt HIST_REDUCE_BLANKS   # Remove superfluous blanks before recording

# ============== Initialization ==============
# Starship prompt initialization
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
export STARSHIP_CONFIG=~/.config/starship/starship.toml

# Fuzzy finder (fzf) setup
if command -v fzf >/dev/null 2>&1; then
  fzf_help_text="$(fzf --help 2>&1 || true)"

  if [[ "$fzf_help_text" == *"--zsh"* ]]; then
    source <(fzf --zsh)
  else
    fzf_shell_paths=()

    if command -v brew >/dev/null 2>&1; then
      fzf_shell_paths+=("$(brew --prefix)/opt/fzf/shell/key-bindings.zsh")
      fzf_shell_paths+=("$(brew --prefix)/opt/fzf/shell/completion.zsh")
    fi

    fzf_shell_paths+=(
      "/usr/share/fzf/key-bindings.zsh"
      "/usr/share/fzf/completion.zsh"
      "/usr/local/share/fzf/key-bindings.zsh"
      "/usr/local/share/fzf/completion.zsh"
      "/opt/homebrew/opt/fzf/shell/key-bindings.zsh"
      "/opt/homebrew/opt/fzf/shell/completion.zsh"
    )

    for fzf_shell_path in "${fzf_shell_paths[@]}"; do
      if [ -f "$fzf_shell_path" ]; then
        source "$fzf_shell_path"
      fi
    done
  fi
fi

# Case-insensitive completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Completion system
autoload bashcompinit && bashcompinit
autoload -Uz compinit
compinit

# Autosuggestions
zsh_autosuggestions_paths=()

if command -v brew >/dev/null 2>&1; then
  zsh_autosuggestions_paths+=("$(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh")
fi

zsh_autosuggestions_paths+=(
  "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  "/usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  "/opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  "$HOME/.local/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
)

for zsh_autosuggestions_path in "${zsh_autosuggestions_paths[@]}"; do
  if [ -f "$zsh_autosuggestions_path" ]; then
    source "$zsh_autosuggestions_path"
    break
  fi
done

# ================ NVM Setup ==================
#
# Node Version Manager setup
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# ================== Aliases ===================
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias ~="cd ~"
alias -- -="cd -"

# Git
alias g="git"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gs="git status"
alias gl="git log --oneline"

# Safety nets
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"

# Misc
alias reload="source ~/.zshrc"
alias path='echo -e ${PATH//:/\\n}'
alias ports='lsof -iTCP -sTCP:LISTEN -n -P'
alias v="nvim"
alias vi="nvim"
alias vim="nvim"
if command -v eza >/dev/null 2>&1; then
  alias ls="eza"
  alias l="eza -1"
  alias lh="eza -lah"
  alias ll="eza -l"
  alias la="eza -la"
  alias lt="eza --tree"
  alias tree="eza --tree"
fi

# ================== Zoxide ==================
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# ================== Sesh ====================
if command -v sesh >/dev/null 2>&1; then
  sesh() {
    local local_cfg="$HOME/.config/sesh/local.toml"
    local base_cfg="$HOME/.config/sesh/sesh.toml"
    if [ -f "$local_cfg" ]; then
      local tmp_cfg
      tmp_cfg="$(mktemp /tmp/sesh-merged.XXXXXX.toml)"
      cat "$base_cfg" "$local_cfg" > "$tmp_cfg"
      command sesh --config "$tmp_cfg" "$@"
      local exit_code=$?
      rm -f "$tmp_cfg"
      return $exit_code
    else
      command sesh "$@"
    fi
  }
fi

# ============== Additional Configs ============
# Add Opencode binaries to PATH
export PATH="$HOME/.opencode/bin:$PATH"

if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# SSH Authentication Agent
op_ssh_auth_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [ -S "$op_ssh_auth_sock" ]; then
  export SSH_AUTH_SOCK="$op_ssh_auth_sock"
fi
